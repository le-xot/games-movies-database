{
  "ignorePatterns": [],
  "printWidth": 100,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "semi": false,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "type",
      "side_effect",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "newlinesBetween": false,
    "sortSideEffects": true
  }
}
