{
  "name": "backend",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "bun check -b",
    "test": "bun test",
    "test:integration": "RUN_DB_TESTS=1 bun run src/__integration__/setup-db.ts && RUN_DB_TESTS=1 bun test src/__integration__",
    "test:integration:reset": "RUN_DB_TESTS=1 bun run src/__integration__/setup-db.ts --reset && RUN_DB_TESTS=1 bun test src/__integration__",
    "start": "bun run ./src/main.ts",
    "dev": "bun run --watch --no-clear-screen ./src/main.ts",
    "openapi:golden": "bun run scripts/generate-openapi-golden.ts"
  },
  "dependencies": {
    "@elysia/openapi": "1.4.16",
    "@gmd/database": "workspace:*",
    "@gmdb/contract": "workspace:*",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "envalid": "8.2.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
