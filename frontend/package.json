{
  "name": "frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate:api && vite --host",
    "generate:api": "bun run --cwd ../backend export:openapi && openapi-typescript openapi.json --enum --root-types --root-types-no-schema-prefix --root-types-keep-casing -o src/lib/api-types.ts",
    "typecheck": "bun run generate:api && vue-tsc",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "build": "bun run generate:api && bun run --parallel build:types build:ci",
    "build:types": "vue-tsc",
    "build:ci": "bunx --bun vite build",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@gmdb/contract": "workspace:*",
    "@lucide/vue": "1.61.0",
    "@pinia/colada": "1.4.8",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.48",
    "@unovis/ts": "1.7.1",
    "@unovis/vue": "1.7.1",
    "@vue/devtools-api": "^8",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "vee-validate": "5.0.0-beta.0",
    "vite-svg-loader": "5.1.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "vue3-simple-icons": "16.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "vite": "8.3.5",
    "vue-tsc": "3.3.11"
  }
}
