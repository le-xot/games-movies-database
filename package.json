{
  "name": "lexot-website",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "contract"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun --filter=./frontend run dev",
    "dev:backend": "bun --filter=./backend run dev",
    "build": "bun run --filter '*' build",
    "build:frontend": "bun --filter=./frontend run build",
    "build:backend": "bun --filter=./backend run build",
    "start:backend": "bun --filter=./backend run start",
    "db:generate": "bun --filter=./database run generate",
    "db:migrate": "bun --filter=./database run migrate",
    "db:baseline": "bun --filter=./database run baseline",
    "test:integration": "bun --filter=./backend run test:integration",
    "test:e2e": "bun --filter=./frontend run test:e2e",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun run --filter '*' --parallel --elide-lines=0 typecheck",
    "test:scripts": "bash scripts/__tests__/render-env.test.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "infra:start": "docker compose -f docker-compose.dev.yml up -d",
    "infra:stop": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxlint": "1.89.0"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@parcel/watcher",
    "esbuild",
    "vite",
    "vue-demi",
    "vue-tsc"
  ]
}
